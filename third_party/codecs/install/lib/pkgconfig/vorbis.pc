# libvorbis pkg-config source file

prefix=/root/ape_player/third_party/codecs/install
exec_prefix=/root/ape_player/third_party/codecs/install/bin
libdir=/root/ape_player/third_party/codecs/install/lib
includedir=/root/ape_player/third_party/codecs/install/include

Name: vorbis
Description: vorbis is the primary Ogg Vorbis library
Version: 1.3.7
Requires.private: ogg
Conflicts:
Libs: -L${libdir} -lvorbis 
Libs.private: 
Cflags: -I${includedir}
