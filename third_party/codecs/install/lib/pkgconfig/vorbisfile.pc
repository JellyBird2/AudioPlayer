# libvorbisfile pkg-config source file

prefix=/root/ape_player/third_party/codecs/install
exec_prefix=/root/ape_player/third_party/codecs/install/bin
libdir=/root/ape_player/third_party/codecs/install/lib
includedir=/root/ape_player/third_party/codecs/install/include

Name: vorbisfile
Description: vorbisfile is a library that provides a convenient high-level API for decoding and basic manipulation of all Vorbis I audio streams
Version: 1.3.7
Requires.private: vorbis
Conflicts:
Libs: -L${libdir} -lvorbisfile
Cflags: -I${includedir}
