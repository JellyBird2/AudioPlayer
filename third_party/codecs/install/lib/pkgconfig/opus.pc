# Opus codec reference implementation pkg-config file

prefix=/root/ape_player/third_party/codecs/install
exec_prefix=/root/ape_player/third_party/codecs/install
libdir=/root/ape_player/third_party/codecs/install/lib
includedir=/root/ape_player/third_party/codecs/install/include

Name: Opus
Description: Opus IETF audio codec ( build)
URL: https://opus-codec.org/
Version: 1.5.2
Requires:
Conflicts:
Libs: -L/root/ape_player/third_party/codecs/install/lib -lopus
Libs.private: -lm
Cflags: -I/root/ape_player/third_party/codecs/install/include/opus
